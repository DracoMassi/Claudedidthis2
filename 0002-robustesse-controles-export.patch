-+type State = 'idle' | 'loading' | 'success' | 'error';
-+type Props = Omit<ButtonHTMLAttributes<HTMLButtonElement>, 'onClick' | 'children'> & {
-+  /** Action asynchrone. `false` ou une exception = échec ; tout le reste = succès. */
-+  run: () => Promise<boolean | void>;
-+  children: ReactNode;
-+  successLabel?: string;
-+  errorLabel?: string;
-+};
