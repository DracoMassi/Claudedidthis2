+.palette-preview .pp-titre { font-size: 28px; font-weight: 700; color: var(--f-rouge); }
+.palette-preview .pp-sous { font-size: 15px; color: var(--f-rouge-fonce); }
+.palette-preview .pp-piege { margin-top: 6px; font-size: 14px; font-weight: 600; color: var(--f-rouge-fonce); }
