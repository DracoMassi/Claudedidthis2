+.ms-group button[aria-checked="true"] { --b: var(--card); box-shadow: var(--shadow-sm); }
+.ms-group button:disabled { opacity: .55; }
+.blockpicker .blockpage { border: 0; margin: 0 0 10px; padding: 0; }
+.blockpicker legend { font-size: 14px; font-weight: 600; padding: 0; margin-bottom: 4px; }
+.check { display: flex; align-items: flex-start; gap: 10px; cursor: pointer; font-size: 15px; }
+.check input { margin-top: 3px; width: 18px; height: 18px; accent-color: var(--accent); flex: none; }
+@media (prefers-reduced-motion: reduce) { .indeterminate i, .nav .live { animation: none; } .indeterminate i { width: 100%; opacity: .35; } }
+
+/* Aperçu des couleurs de fiche dans Réglages : fond blanc fixe, comme sur la fiche imprimée. */
+.palette-preview { display: grid; gap: 2px; justify-items: center; margin-top: 16px; padding: 16px; border-radius: 16px; background: #FFFFFF; color: #000000; border: 1px solid var(--hair); text-align: center; }
