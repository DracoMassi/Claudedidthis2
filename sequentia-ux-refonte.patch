+++ b/src/theme/design.css
@@ -0,0 +1,195 @@
+/* Séquentia — mise en page, hiérarchie, états. Chargée après apple.css.
+   Principe : le quadrillé et le rouge restent la signature ; tout le reste se tait.
+   Un seul moment orchestré : le changement d'écran. Le reste du mouvement répond à un geste. */
+
+:root {
+  --gap: 20px;
+  --measure: 62ch;
+  --muted: color-mix(in srgb, var(--text) 62%, transparent);
+  --hair: color-mix(in srgb, var(--text) 12%, transparent);
+}
+
+/* ───────── Structure ───────── */
+.app { display: flex; flex-direction: column; padding-bottom: calc(env(safe-area-inset-bottom) + 112px); }
+.app > .screen { display: block; }
+.app .card { margin: 0 0 var(--gap); }
+.app .card > :first-child { margin-top: 0; }
+.app .card > :last-child { margin-bottom: 0; }
+
+.topbar { display: flex; align-items: center; gap: 16px; }
+.topbar .logo { padding: 18px 0 4px; margin-right: auto; }
+.logo { display: block; }
+
+/* Navigation : l'écran courant est marqué par une forme, pas seulement par la couleur */
+.nav button { position: relative; }
+
+.nav .dot { min-width: 18px; height: 18px; padding: 0 5px; margin-left: 6px; border-radius: 9px; background: var(--accent); color: #fff; font-size: 11px; font-weight: 700; display: inline-grid; place-items: center; letter-spacing: 0; }
+
+/* Titre d'écran : une phrase d'usage sous le titre */
+.pagehead { margin: 28px 0 24px; }
+.pagehead .titre { margin: 0 0 8px; font-size: clamp(34px, 5.4vw, 52px); }
+.pagehead .lead { margin: 0; max-width: var(--measure); font-size: 17px; color: var(--muted); }
+
+/* Changement d'écran : l'unique entrée animée de l'app */
+.screen { animation: screen-in 320ms var(--ease-out-expo) both; }
+@keyframes screen-in { from { opacity: 0; transform: translateY(10px); } }
+
+/* ───────── Formulaires ───────── */
+.group { padding: 4px 0 8px; }
+.group + .group { margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--hair); }
+.group-head h2 { margin: 0; font-family: var(--font-section); font-size: 20px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
+.group-head p { margin: 4px 0 0; font-size: 15px; color: var(--muted); max-width: var(--measure); }
+.group-head { margin-bottom: 12px; }
+.grid2 { display: grid; gap: 0 16px; grid-template-columns: 1fr; }
+.grid3 { display: grid; gap: 0 16px; grid-template-columns: 1fr; }
+@media (min-width: 640px) { .grid2 { grid-template-columns: 1fr 1fr; } .grid3 { grid-template-columns: repeat(3, 1fr); } }
+.grid2 > .field, .grid3 > .field { margin: 8px 0; }
+
+.adv { margin-top: 20px; border-top: 1px solid var(--hair); padding-top: 14px; }
+.adv > summary, .attempts > summary, .json > summary {
+  cursor: pointer; font-weight: 600; font-size: 15px; list-style: none; display: flex; align-items: center; gap: 8px; min-height: 36px;
+}
+.adv > summary::-webkit-details-marker, .attempts > summary::-webkit-details-marker, .json > summary::-webkit-details-marker { display: none; }
+.adv > summary::before, .attempts > summary::before, .json > summary::before {
+  content: ""; width: 8px; height: 8px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
+  transform: rotate(-45deg); transition: transform var(--dur-fast) var(--ease-apple); opacity: .6;
+}
+.adv[open] > summary::before, .attempts[open] > summary::before, .json[open] > summary::before { transform: rotate(45deg); }
+
+/* Zone de dépôt : un fichier à choisir, dit clairement */
+.drop {
+  display: flex; align-items: center; gap: 14px; padding: 14px 16px; margin: 0 0 16px; border: 1.5px dashed color-mix(in srgb, var(--text) 25%, transparent);
+  border-radius: var(--r-field); cursor: pointer; font-size: 15px;
+  transition: border-color var(--dur-fast) var(--ease-apple), background-color var(--dur-fast) var(--ease-apple);
+}
+.drop:hover, .drop:focus-within { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 5%, transparent); }
+.drop svg { flex: none; color: var(--accent-text); }
+.drop b { display: block; font-weight: 600; }
+.drop span { color: var(--muted); font-size: 14px; }
+.drop input[type="file"] { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
+.drop-row { display: grid; gap: 0 16px; grid-template-columns: 1fr; }
+@media (min-width: 640px) { .drop-row { grid-template-columns: 1fr 1fr; } }
+
+/* ───────── Barre d'action collée en bas ───────── */
+.actionbar {
+  position: sticky; bottom: calc(env(safe-area-inset-bottom) + 12px); z-index: 15; display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
+  margin: 8px 0 var(--gap); padding: 12px 14px 12px 20px; border-radius: var(--r-card);
+  background: color-mix(in srgb, var(--card) 80%, transparent);
+  -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px);
+  border: 1px solid var(--hair); box-shadow: var(--shadow-md);
+}
+.actionbar .grow { flex: 1 1 200px; min-width: 0; font-size: 14px; color: var(--muted); }
+.actionbar .grow b { color: var(--text); font-weight: 600; }
+.actionbar .btns { display: flex; gap: 8px; flex-wrap: wrap; }
+.btn-lg { min-height: 52px; padding: 0 30px; font-size: 17px; }
+
+/* Jauge de requêtes */
+.quota { display: inline-flex; align-items: center; gap: 10px; font-size: 14px; color: var(--muted); }
+.quota-bar { width: 56px; height: 6px; border-radius: 3px; background: var(--tint-hover); overflow: hidden; }
+.quota-bar i { display: block; height: 100%; border-radius: inherit; background: var(--accent); transition: width var(--dur-base) var(--ease-apple); }
+.quota-bar i[data-hot] { background: var(--warn); }
+
+/* Étapes de génération */
+.stepper { display: flex; gap: 4px; height: 6px; width: 100%; max-width: 220px; margin: 8px 0 0; }
+.stepper span { flex: 1; border-radius: 3px; background: var(--tint-hover); transition: background-color var(--dur-base) var(--ease-apple); }
+.stepper span[data-s="done"] { background: var(--accent); }
+.stepper span[data-s="now"] { background: var(--accent); animation: pulse 1.2s ease-in-out infinite; }
+
+/* ───────── Messages ───────── */
+.notice {
+  display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: start; margin: 0 0 var(--gap); padding: 14px 16px;
+  border-radius: var(--r-field); font-size: 15px; line-height: 1.4;
+  --c: var(--accent-text); background: color-mix(in srgb, var(--c) 10%, var(--card)); color: var(--text);
+  border: 1px solid color-mix(in srgb, var(--c) 28%, transparent);
+}
+.notice > svg { margin-top: 2px; color: var(--c); }
+.notice[data-k="ok"] { --c: var(--success); }
+.notice[data-k="error"] { --c: var(--danger); }
+.notice[data-k="info"] { --c: var(--accent-text); }
+.notice > div { min-width: 0; overflow-wrap: anywhere; }
+.notice button { min-height: 36px; padding: 0 16px; font-size: 14px; align-self: center; }
+.card .notice { margin: 16px 0 0; }
+
+/* ───────── Vide ───────── */
+.empty { padding: 28px 24px; border: 1.5px dashed color-mix(in srgb, var(--text) 20%, transparent); border-radius: var(--r-card); text-align: center; display: grid; justify-items: center; gap: 6px; margin-bottom: var(--gap); }
+.empty b { font-size: 17px; }
+.empty p { margin: 0 0 8px; color: var(--muted); max-width: 46ch; font-size: 15px; }
+
+/* ───────── Listes de brouillons et d'imports ───────── */
+.rows { display: grid; gap: 12px; margin: 0 0 var(--gap); padding: 0; list-style: none; }
+.rowcard { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; padding: 16px 20px; border-radius: var(--r-card); background: var(--card); }
+:root[data-mode="dark"] .rowcard { border: 1px solid var(--sep); }
+.rowcard .what { flex: 1 1 240px; min-width: 0; }
+.rowcard .what b { display: block; font-size: 17px; line-height: 1.3; overflow-wrap: anywhere; }
+.rowcard .what small { color: var(--muted); font-size: 14px; }
+.rowcard .acts { display: flex; gap: 8px; flex-wrap: wrap; }
+.rowcard button { min-height: 40px; padding: 0 18px; font-size: 15px; }
+.h2 { font-family: var(--font-section); font-size: 22px; font-weight: 600; letter-spacing: -0.02em; margin: 36px 0 12px; display: flex; align-items: baseline; gap: 10px; }
+.h2 small { font-family: var(--font-corps); font-size: 14px; font-weight: 400; color: var(--muted); letter-spacing: 0; }
+
+/* ───────── Bibliothèque ───────── */
+.libgrid { list-style: none; padding: 0; margin: 0 0 var(--gap); display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
+.libcard { all: unset; box-sizing: border-box; display: flex; flex-direction: column; gap: 10px; width: 100%; height: 100%; min-height: 108px; padding: 16px 18px; border-radius: var(--r-card); background: var(--card); cursor: pointer;
+  transition: transform var(--dur-base) var(--ease-apple), box-shadow var(--dur-base) var(--ease-apple), outline-color var(--dur-fast); outline: 2px solid transparent; }
+:root[data-mode="dark"] .libcard { border: 1px solid var(--sep); }
+.libcard:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
+.libcard:active { transform: scale(.985); }
+.libcard[aria-pressed="true"] { outline: 2px solid var(--accent); outline-offset: -2px; }
+.libcard:focus-visible { outline: 4px solid var(--focus); outline-offset: 2px; }
+.libcard b { font-size: 17px; line-height: 1.3; font-weight: 600; overflow-wrap: anywhere; }
+.libcard .meta { margin-top: auto; display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
+.chip { display: inline-flex; align-items: center; gap: 5px; height: 24px; padding: 0 10px; border-radius: var(--r-pill); font-size: 13px; font-weight: 500; letter-spacing: 0; background: var(--tint); color: var(--text); }
+.chip[data-k="ok"] { background: color-mix(in srgb, var(--success) 15%, transparent); color: var(--success); font-weight: 600; }
+.chip[data-k="accent"] { background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent-text); }
+
+.toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 16px; }
+.toolbar .sp { flex: 1; }
+.search { display: flex; gap: 12px; flex-wrap: wrap; }
+.search .field { margin: 0; flex: 1 1 220px; }
+.previewbox { margin-top: 8px; padding: 16px; border-radius: var(--r-field); background: var(--page-bg); overflow: auto; max-width: 100%; }
+.cours-text { white-space: pre-wrap; font-size: 15px; line-height: 1.55; max-width: 80ch; }
+
+/* ───────── Relecture ───────── */
+.checks { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
+.checks .detail { flex-basis: 100%; font-size: 14px; color: var(--muted); overflow-wrap: anywhere; }
+.pane.card { max-height: none; }
+@media (min-width: 900px) { .review .pane.card, .review .pane { position: relative; } .review > .pane:last-child { position: sticky; top: 56px; max-height: calc(100vh - 72px); overflow: auto; } }
+fieldset { margin: 12px 0; padding: 4px 16px 12px; background: color-mix(in srgb, var(--text) 3%, transparent); }
+legend { padding: 0 8px; font-size: 13px; font-weight: 600; color: var(--muted); }
+.page-title { margin: 20px 0 4px; font-size: 20px; }
+.checklist { display: grid; gap: 4px; margin: 4px 0 16px; }
+.checklist label { display: flex; align-items: flex-start; gap: 10px; padding: 8px 4px; min-height: 44px; cursor: pointer; line-height: 1.35; }
+.checklist input[type="checkbox"] { flex: none; margin: 0; }
+.progress-text { font-size: 14px; color: var(--muted); margin: 0 0 4px; }
+.diff { display: grid; gap: 12px; grid-template-columns: 1fr; }
+@media (min-width: 640px) { .diff { grid-template-columns: 1fr 1fr; } }
+.diff pre { margin: 6px 0 0; padding: 12px; border-radius: 12px; background: var(--page-bg); font-size: 12px; white-space: pre-wrap; max-height: 320px; overflow: auto; }
+
+/* ───────── Réglages et thème ───────── */
+.status-line { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
+.swatches { display: grid; gap: 10px; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
+.swatch { display: grid; gap: 8px; justify-items: stretch; width: 100%; height: auto; padding: 10px; border-radius: 16px; background: var(--card); border: 1.5px solid var(--sep); font-size: 14px; text-align: left; font-weight: 500; }
+.swatch i { display: block; width: 100%; height: 44px; border-radius: 10px; border: 1px solid var(--hair); position: relative; overflow: hidden; }
+.swatch i::after { content: ""; position: absolute; right: 8px; bottom: 8px; width: 16px; height: 16px; border-radius: 50%; background: var(--sw-accent, var(--accent)); }
+.swatch[aria-pressed="true"] { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent); background: var(--card); --b: var(--card); --f: var(--text); font-weight: 600; }
+.segmented { display: inline-flex; padding: 3px; border-radius: var(--r-pill); background: var(--tint); }
+.segmented button { --b: transparent; min-height: 38px; padding: 0 20px; font-size: 15px; }
+.segmented button[aria-pressed="true"] { --b: var(--card); --f: var(--text); font-weight: 600; box-shadow: 0 1px 3px rgba(0,0,0,.12); }
+.colors { display: flex; gap: 12px; flex-wrap: wrap; }
+.colors label { display: grid; gap: 6px; font-size: 14px; color: var(--muted); }
+.colors input[type="color"] { width: 56px; height: 44px; padding: 2px; border: 1.5px solid var(--sep); border-radius: 12px; background: var(--card); cursor: pointer; }
+.muted { color: var(--muted); }
+
+/* ───────── Petits écrans ───────── */
+@media (max-width: 640px) {
+  .nav button { padding: 0 10px; font-size: 13.5px; }
+  .notice { grid-template-columns: auto 1fr; }
+  .notice > button { grid-column: 1 / -1; width: 100%; }
+  .actionbar { padding: 12px; }
+  .actionbar .btns, .actionbar .btns > *, .actionbar .btns button { width: 100%; }
+  .rowcard .acts button { flex: 1 1 auto; }
+  .app .card { padding: 16px; }
+}
+
+@media (prefers-reduced-motion: reduce) { .screen { animation: none; } .stepper span[data-s="now"] { animation: none; } }
+@media print { .actionbar, .topbar { display: none !important; } }
