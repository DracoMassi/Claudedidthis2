+/* Séquentia — couche « floaty & glassy ».
+   Chargée APRÈS theme.css. Aucune couleur en dur : tout dérive des variables du thème
+   (--card, --accent, --page-bg…), donc les 4 préréglages, le mode Auto/Clair/Sombre et
+   les couleurs personnalisées continuent de fonctionner. */
+
+:root {
+  --g-bg: color-mix(in srgb, var(--card) 58%, transparent);
+  --g-bg-strong: color-mix(in srgb, var(--card) 80%, transparent);
+  --g-edge: rgba(255, 255, 255, .7);
+  --g-line: color-mix(in srgb, var(--accent) 16%, transparent);
+  --g-shadow: 0 18px 50px -14px color-mix(in srgb, var(--accent-dark) 40%, transparent),
+              0 4px 14px -4px color-mix(in srgb, var(--accent-dark) 22%, transparent);
+  --g-radius: 22px;
+}
+:root[data-mode="dark"] {
+  --g-edge: rgba(255, 255, 255, .12);
+  --g-shadow: 0 18px 50px -14px rgba(0, 0, 0, .7), 0 4px 14px -4px rgba(0, 0, 0, .5);
+}
+
+/* Halos flous qui dérivent derrière le quadrillé */
+body::before {
+  content: ''; position: fixed; inset: -20%; z-index: -1; pointer-events: none;
+  background:
+    radial-gradient(40% 35% at 15% 20%, color-mix(in srgb, var(--accent) 30%, transparent), transparent 70%),
+    radial-gradient(35% 40% at 85% 15%, color-mix(in srgb, var(--accent) 18%, #ff9bb0), transparent 70%),
+    radial-gradient(45% 40% at 70% 90%, color-mix(in srgb, #ffbe78 26%, transparent), transparent 70%);
+  filter: blur(40px);
+  animation: g-drift 26s ease-in-out infinite alternate;
+}
+@keyframes g-drift { to { transform: translate3d(3%, -2%, 0) scale(1.08); } }
+
+/* Verre */
+.card, .glass {
+  background: var(--g-bg);
+  -webkit-backdrop-filter: blur(22px) saturate(170%);
+  backdrop-filter: blur(22px) saturate(170%);
+  border: 1px solid var(--g-edge);
+  border-radius: var(--g-radius);
+  box-shadow: var(--g-shadow), inset 0 1px 0 rgba(255, 255, 255, .4);
+  padding: 16px 18px;
+}
+
+/* Titre + logo */
+.logo { font-size: 26px; }
+.titre { letter-spacing: -.01em; }
+
+/* Navigation : pastille flottante, collante en haut */
+.nav {
+  position: sticky; top: calc(env(safe-area-inset-top, 0px) + 8px); z-index: 20;
+  width: fit-content; max-width: 100%; margin: 4px 0 8px; padding: 6px; gap: 4px;
+  background: var(--g-bg); border: 1px solid var(--g-edge); border-radius: 999px;
+  -webkit-backdrop-filter: blur(24px) saturate(180%); backdrop-filter: blur(24px) saturate(180%);
+  box-shadow: var(--g-shadow);
+}
+.nav button { padding: 9px 16px; font-weight: 600; transition: background .25s, color .25s, transform .25s; }
+.nav button:hover { transform: translateY(-1px); }
+.nav button[aria-current="page"] {
+  background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 80%, #fff), var(--accent));
+  box-shadow: 0 6px 16px -4px color-mix(in srgb, var(--accent) 60%, transparent);
+}
+
+/* Boutons : tous en pastille de verre ; .btn = action principale */
+button:not(.nav button) {
+  font: inherit; font-weight: 600; color: var(--accent-dark); cursor: pointer;
+  background: var(--g-bg); border: 1px solid var(--g-edge); border-radius: 999px; padding: 9px 18px;
+  -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
+  transition: transform .25s cubic-bezier(.2, .8, .2, 1), box-shadow .25s;
+}
+button:not(.nav button):hover:not(:disabled) { transform: translateY(-2px); box-shadow: var(--g-shadow); }
+button:not(.nav button):disabled { opacity: .45; cursor: not-allowed; }
+.btn, button[aria-pressed="true"]:not(.nav button) {
+  color: #fff; border-color: transparent;
+  background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 78%, #fff), var(--accent) 65%, var(--accent-dark));
+  box-shadow: 0 12px 26px -8px color-mix(in srgb, var(--accent) 65%, transparent), inset 0 1px 0 rgba(255, 255, 255, .35);
+}
+.btn.ghost:not([aria-pressed="true"]) { color: var(--accent-dark); background: var(--g-bg); box-shadow: none; }
+
+/* Champs */
+input:not([type="checkbox"]):not([type="file"]), select, textarea {
+  font: inherit; color: var(--text); background: var(--g-bg-strong);
+  border: 1px solid var(--g-line); border-radius: 14px; outline: none;
+  transition: border-color .2s, box-shadow .2s;
+}
+input:focus, select:focus, textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent); }
+fieldset { border: 1px solid var(--g-line); border-radius: 16px; }
+
+/* Cartes qui flottent (Bibliothèque) */
+.float-card { animation: g-float 7s ease-in-out infinite; transition: transform .35s; }
+.float-card:nth-child(2n) { animation-delay: -2.3s; }
+.float-card:nth-child(3n) { animation-delay: -4.6s; }
+.float-card:hover { animation-play-state: paused; transform: translateY(-8px) rotate(-.6deg) scale(1.02); }
+@keyframes g-float { 50% { transform: translateY(-8px) rotate(.4deg); } }
+
+/* Export PNG/PDF : les pages de fiche restent PLATES (backdrop-filter casse modern-screenshot). */
+.export-root, .export-root *, .print-area, .print-area *, [data-fiche], [data-fiche] * {
+  -webkit-backdrop-filter: none !important; backdrop-filter: none !important; animation: none !important;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  body::before, .float-card { animation: none; }
+  * { transition-duration: .01ms !important; }
+}
+@media print {
+  body::before { display: none !important; }
+  .card, .glass { background: none !important; border: 0 !important; box-shadow: none !important; -webkit-backdrop-filter: none !important; backdrop-filter: none !important; }
+}
